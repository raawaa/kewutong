# Use npmmirror.com for Electron binary downloads so first-time / fresh
# `npm install` doesn't have to crawl GitHub's release CDN (slow from China).
#
# See https://www.electronjs.org/docs/latest/tutorial/installation#mirror
#
# @electron/get reads this as process.env.npm_config_electron_mirror
# (see node_modules/.../artifact-utils.js mirrorVar priority chain:
#  npm_config_<key> > NPM_CONFIG_<KEY> > npm_package_config_<key> > ELECTRON_<KEY>).
# Both npm and pnpm translate .npmrc into npm_config_* env vars for child processes,
# so this single file works for either package manager.
electron_mirror=https://npmmirror.com/mirrors/electron/